# Copy to `.env` in the repository root. Every value below is optional — the
# defaults shown are what the backend uses when the variable is unset.

# --- Server -----------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Database ---------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/
# Every uploaded archive becomes its own database named "<prefix>_<archive>".
MONGO_DB_NAME=warden_ship
MONGO_DB_PREFIX=warden_ship

# --- F1 semantic search -----------------------------------------------------
# Leave empty to use `openai/clip-vit-base-patch32` from Hugging Face. Point it
# at a local directory to run the art-contrastive fine-tuned CLIP instead.
CLIP_MODEL_PATH=

# --- F2 style / genre / artist classifier -----------------------------------
# `image`      — self-contained TorchScript export from training/f2_classification
# `clip-linear`— lightweight linear heads over frozen CLIP embeddings
F2_MODEL_KIND=image
F2_MODEL_PATH=
F2_LABELS_PATH=
F2_MODEL_DEVICE=cpu
F2_INPUT_SIZE=224

# --- F5 history map ---------------------------------------------------------
# Defaults to the committed data/f5_year_head/f5_year_head.pt.
F5_YEAR_MODEL_PATH=
F5_EMBED_MODEL_PATH=
# Set to 1 to embed at pipeline time instead of reusing the vectors F1 wrote.
F5_RUNTIME_CLIP=0

# --- F6 attribute filters ---------------------------------------------------
HEAD_POSE_BACKEND=retinaface
HEAD_POSE_MODEL_PATH=
